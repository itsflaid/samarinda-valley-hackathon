generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  nohp         String   @unique
  password     String
  role         Role
  profesi      Profesi?
  instansi     String?
  wilayahKerja String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  NAKES
  PETUGAS
  ADMIN
}

enum Profesi {
  DOKTER
  PERAWAT
  BIDAN
}

enum IPAStatus {
  AKTIF
  MATI
}

enum RegionStatus {
  AMAN
  WASPADA
  SIAGA
}

model Region {
  id            String        @id @default(cuid())
  name          String
  city          String
  province      String
  latitude      Decimal
  longitude     Decimal
  status        RegionStatus  @default(AMAN)
  ipaStatus     IPAStatus
  ipaCondition  String?
  healthReports HealthReport[]
  waterReports  WaterReport[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([city])
  @@index([province])
}

model HealthReport {
  id             String   @id @default(cuid())
  reporterName   String
  reporterPhone  String
  regionId       String
  region         Region   @relation(fields: [regionId], references: [id])
  diarrhea       Boolean  @default(false)
  vomiting       Boolean  @default(false)
  fever          Boolean  @default(false)
  dehydration    Boolean  @default(false)
  latitude       Float
  longitude      Float
  reportedAt     DateTime @default(now())
}

model WaterReport {
  id                String   @id @default(cuid())
  reporterName      String
  reporterPhone     String
  regionId          String
  region            Region   @relation(fields: [regionId], references: [id])
  supplyDisruption  Boolean  @default(false)
  dirtyOrSmelly     Boolean  @default(false)
  saltyOrBrackish   Boolean  @default(false)
  dryWell           Boolean  @default(false)
  latitude          Float
  longitude         Float
  reportedAt        DateTime @default(now())
}
