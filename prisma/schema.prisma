  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  nohp             String             @unique
  password         String
  role             Role
  profesi          Profesi?
  instansi         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  facilities       FacilityStaff[]
  HealthAssessment HealthAssessment[]
  regions          UserRegion[]
}

model Region {
  id               String             @id @default(cuid())
  name             String
  city             String
  province         String
  latitude         Decimal
  longitude        Decimal
  status           RegionStatus       @default(AMAN)
  ipaStatus        IPAStatus
  ipaCondition     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  facilities       Facility[]
  HealthAssessment HealthAssessment[]
  healthReports    HealthReport[]
  users            UserRegion[]
  waterReports     WaterReport[]

  @@index([city])
  @@index([province])
}

model UserRegion {
  id        String   @id @default(cuid())
  userId    String
  regionId  String
  createdAt DateTime @default(now())
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, regionId])
  @@index([userId])
  @@index([regionId])
}

model HealthReport {
  id               String             @id @default(cuid())
  reporterName     String
  reporterPhone    String
  regionId         String
  diarrhea         Boolean            @default(false)
  vomiting         Boolean            @default(false)
  fever            Boolean            @default(false)
  dehydration      Boolean            @default(false)
  latitude         Float
  longitude        Float
  reportedAt       DateTime           @default(now())
  HealthAssessment HealthAssessment[]
  region           Region             @relation(fields: [regionId], references: [id])
}

model WaterReport {
  id               String   @id @default(cuid())
  reporterName     String
  reporterPhone    String
  regionId         String
  supplyDisruption Boolean  @default(false)
  dirtyOrSmelly    Boolean  @default(false)
  saltyOrBrackish  Boolean  @default(false)
  dryWell          Boolean  @default(false)
  latitude         Float
  longitude        Float
  reportedAt       DateTime @default(now())
  region           Region   @relation(fields: [regionId], references: [id])
}

model Facility {
  id           String          @id @default(cuid())
  name         String
  type         FacilityType
  address      String
  regionId     String
  latitude     Float
  longitude    Float
  phone        String?
  openingHours String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  region       Region          @relation(fields: [regionId], references: [id])
  staffs       FacilityStaff[]

  @@index([regionId])
  @@index([type])
}

model FacilityStaff {
  id         String   @id @default(cuid())
  userId     String
  facilityId String
  createdAt  DateTime @default(now())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([userId])
  @@index([facilityId])
}

